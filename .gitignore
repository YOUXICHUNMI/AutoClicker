# 虚拟环境
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# 日志和数据库
*.log
log/
*.db
*.sqlite3

# 运行期数据目录（正常经启动脚本/exe 运行时落在 dist/ 下，
